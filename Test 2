<script>
// ===== НАСТРОЙКИ: впишите свои значения =====
const GA_ID  = 'G-XXXXXXXXXX';              // Google Analytics 4
const PUB_ID = 'ca-pub-XXXXXXXXXXXXXXXX';   // Google AdSense
// ============================================

(() => {
  const $ = (id) => document.getElementById(id);
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }

  // Consent Mode v2: по умолчанию всё запрещено
  gtag('consent', 'default', {
    ad_storage:'denied', ad_user_data:'denied', ad_personalization:'denied', analytics_storage:'denied'
  });

  const getConsent = () => (document.cookie.match(/(?:^|; )consent=(granted|denied)/) || [])[1] || null;
  const setConsent = (v) => {
    document.cookie = 'consent=' + v + '; max-age=' + (60*60*24*180) + '; path=/; SameSite=Lax' +
      (location.protocol === 'https:' ? '; Secure' : '');
  };
  const clearGa = () => document.cookie.split('; ').forEach((c) => {
    const n = c.split('=')[0];
    if (n === '_ga' || n.indexOf('_ga_') === 0) document.cookie = n + '=; max-age=0; path=/';
  });

  let gaLoaded = false;
  function loadGA(){
    if (gaLoaded || GA_ID.indexOf('XXXX') > -1) return;
    gaLoaded = true;
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
    document.head.appendChild(s);
    gtag('js', new Date());
    gtag('config', GA_ID, { anonymize_ip: true });
  }

  const banner = $('cookie-banner');
  function apply(v){
    if (v === 'granted'){
      gtag('consent', 'update', { analytics_storage:'granted', ad_storage:'granted',
        ad_user_data:'granted', ad_personalization:'granted' });
      loadGA();
    } else {
      gtag('consent', 'update', { analytics_storage:'denied', ad_storage:'denied',
        ad_user_data:'denied', ad_personalization:'denied' });
      clearGa();
    }
  }
  $('cookie-accept').onclick  = () => { setConsent('granted'); apply('granted'); banner.hidden = true; };
  $('cookie-decline').onclick = () => { setConsent('denied');  apply('denied');  banner.hidden = true; };
  $('cookie-settings').onclick = () => { banner.hidden = false; };

  const saved = getConsent();
  if (saved) apply(saved); else banner.hidden = false;

  // Рекламные блоки: пока ID не вписан, показываем заглушки
  document.querySelectorAll('ins.adsbygoogle').forEach((el) => {
    if (PUB_ID.indexOf('XXXX') > -1) {
      el.className = el.className.replace('adsbygoogle', '').trim() + ' placeholder';
      el.textContent = 'Здесь будет реклама';
    } else {
      el.setAttribute('data-ad-client', PUB_ID);
      try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
    }
  });
})();
</script>
